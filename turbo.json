{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    ".env*"
  ],
  "globalEnv": [
    "NODE_ENV",
    "RESEND_API_KEY",
    "DATA_DIR",
    "CASABOARD_VERSION",
    "SUPERVISOR_TOKEN"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
