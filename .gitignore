# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js
.turbo

# Local env files
.env
.env.*
!.env.example

# Editor / agent local config (may contain machine paths)
.claude/

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
/publish/*
!/publish/.gitkeep

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Runtime data (Docker bind-mount ./data → DATA_DIR; never commit tokens)
/data/*
!/data/.gitkeep
apps/app/data/**/*
__pycache__/
*.py[cod]
